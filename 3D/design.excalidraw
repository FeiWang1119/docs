      "link": null,
      "locked": false,
      "text": "CameraVendor getVendor()\nCameraInterface getInterface()\nCameraInfo getCameraInfo()\nbool IsConnect()\nbool IsGrabbing()\nbool IsTriggerMode()\nvoid RegisterImageCallBack(CamImageCallBack imageCallBack, void *pUser)\nbool Open()\nbool Close()\nbool StartGrab()\nbool StopGrab()\nbool SetTriggerMode(TriggerMode triggerMode, TriggerSource triggerSource)\nbool SnapImage()\nbool SnapImageSync(const unsigned char *&pData, int &width, int &height,\n                                ImageFormat &format, int timeoutMs = 1000)\nbool SetExposure(float value)\nbool GetExposure(float &value)\nbool SetGain(float value)\nbool GetGain(float &value)\nbool SetGamma(float value)\nbool GetGamma(float &value)\nbool SetUserParam(string userName)\nbool LoadUserParam(string userName)",
      "fontSize": 19.86666666666667,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CameraVendor getVendor()\nCameraInterface getInterface()\nCameraInfo getCameraInfo()\nbool IsConnect()\nbool IsGrabbing()\nbool IsTriggerMode()\nvoid RegisterImageCallBack(CamImageCallBack imageCallBack, void *pUser)\nbool Open()\nbool Close()\nbool StartGrab()\nbool StopGrab()\nbool SetTriggerMode(TriggerMode triggerMode, TriggerSource triggerSource)\nbool SnapImage()\nbool SnapImageSync(const unsigned char *&pData, int &width, int &height,\n                                ImageFormat &format, int timeoutMs = 1000)\nbool SetExposure(float value)\nbool GetExposure(float &value)\nbool SetGain(float value)\nbool GetGain(float &value)\nbool SetGamma(float value)\nbool GetGamma(float &value)\nbool SetUserParam(string userName)\nbool LoadUserParam(string userName)",
      "autoResize": true,
      "lineHeight": 1.25
    },
