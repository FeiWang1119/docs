      "seed": 1317349975,
      "version": 92,
      "versionNonce": 1565457049,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777342987237,
      "link": null,
      "locked": false,
      "text": "case 2",
      "fontSize": 20,
      "fontFamily": 6,
