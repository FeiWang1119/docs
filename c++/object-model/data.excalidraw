    {
      "id": "RLlIaIi5Me_T_Yjk4MIhO",
      "type": "text",
      "x": 523.3332875569668,
      "y": 2793.1786248343324,
      "width": 852.0894775390624,
      "height": 100,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Y0izHyeFTvcYX8bpjdu-G",
      "index": "b6Pzzz",
      "roundness": null,
      "seed": 1710410391,
      "version": 136,
      "versionNonce": 1158415289,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777345798043,
      "link": null,
      "locked": false,
      "text": "What about access of a data member of a second or subsequent base class? Is there\nan additional cost? No. The member's location is fixed at compile time. Hence its\naccess is a simple offset the same as under single inheritance regardless of whether\nit is a pointer, reference, or object through which the member is being accessed.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What about access of a data member of a second or subsequent base class? Is there\nan additional cost? No. The member's location is fixed at compile time. Hence its\naccess is a simple offset the same as under single inheritance regardless of whether\nit is a pointer, reference, or object through which the member is being accessed.",
      "autoResize": false,
      "lineHeight": 1.25
    },
