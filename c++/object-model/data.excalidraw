    {
      "id": "DxLAkhvk3xLDu6iXmpsJn",
      "type": "text",
      "x": 1943.8648676400812,
      "y": 3169.3036248343324,
      "width": 77,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
