    {
      "id": "8pKQslGrFvWcI5I3qHFcU",
      "type": "text",
      "x": 764.5832875569668,
      "y": 2245.6786248343324,
      "width": 550,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Y0izHyeFTvcYX8bpjdu-G",
      "index": "b6PzzV",
      "roundness": null,
      "seed": 761689753,
      "version": 201,
      "versionNonce": 783424025,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777346498507,
      "link": null,
      "locked": false,
      "text": "Vertex3d v3d;\nVertex *pv;\nPoint2d *p2d;\nPoint3d *p3d;\n\npv = &v3d;\n// Pseudo C++ Code\npv = (Vertex*)(((char*)&v3d) + sizeof( Point3d ));\n\n// both simply require a copying of the address.\np2d = &v3d;\np3d = &v3d;\n\nVertex3d *pv3d;\nVertex *pv;\npv = p3d;\n// Pseudo C++ Code\npv = pv3d\n? (Vertex*)((char*)p3d) + sizeof( Point3d )\n: 0;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vertex3d v3d;\nVertex *pv;\nPoint2d *p2d;\nPoint3d *p3d;\n\npv = &v3d;\n// Pseudo C++ Code\npv = (Vertex*)(((char*)&v3d) + sizeof( Point3d ));\n\n// both simply require a copying of the address.\np2d = &v3d;\np3d = &v3d;\n\nVertex3d *pv3d;\nVertex *pv;\npv = p3d;\n// Pseudo C++ Code\npv = pv3d\n? (Vertex*)((char*)p3d) + sizeof( Point3d )\n: 0;",
      "autoResize": true,
      "lineHeight": 1.25
    },
