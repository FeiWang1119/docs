        [
          82.82784670875253,
          2.5224167495102847
        ]
      ],
      "startBinding": {
        "elementId": "CyNTn_KRMHhLZ2kK2KVtT",
        "mode": "orbit",
        "fixedPoint": [
          1,
          0.5001
        ]
