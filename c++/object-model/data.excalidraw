      "text": "shared region",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "shared region",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VVPUMr9YfDReXVsGfEd73",
      "type": "text",
      "x": 1247.0396825396829,
      "y": 3831.1785714285706,
      "width": 858,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "z0RWULOWfdgoyUkoZAGuF",
      "index": "ZzzzzzzzzzzzV",
      "roundness": null,
      "seed": 1733773335,
      "version": 1033,
      "versionNonce": 380209335,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777340107688,
      "link": null,
      "locked": false,
      "text": "The shared region represents the virtual base class subobjects. \nThe location of data within the shared region fluctuates with each derivation.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The shared region represents the virtual base class subobjects. \nThe location of data within the shared region fluctuates with each derivation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GG-tM1gaBcobtD5Gw2AGw",
      "type": "text",
      "x": 1245.9285714285716,
      "y": 3760.06746031746,
      "width": 1122,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "z0RWULOWfdgoyUkoZAGuF",
      "index": "Zzzzzzzzzzzzl",
      "roundness": null,
      "seed": 1390763449,
      "version": 976,
      "versionNonce": 1610963415,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777340107688,
      "link": null,
      "locked": false,
      "text": "Data within the invariant region remains at a fixed offset from the start of the object\nregardless of subsequent derivations. So members within the invariant region can be accessed directly.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data within the invariant region remains at a fixed offset from the start of the object\nregardless of subsequent derivations. So members within the invariant region can be accessed directly.",
      "autoResize": true,
      "lineHeight": 1.25
    },
