      "isDeleted": false,
      "boundElements": [],
      "updated": 1777356556368,
      "link": null,
      "locked": false,
      "text": "Point3d",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Point3d",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_zZeyLAV4PxdBNaov-5aR",
      "type": "text",
      "x": 459.99995422363304,
      "y": 5138.928624834332,
      "width": 338.79986572265625,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FOAM7-xkIu1exxseVZPs7",
      "index": "b98V",
      "roundness": null,
      "seed": 804468409,
      "version": 176,
      "versionNonce": 2086047383,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777425494371,
      "link": null,
      "locked": false,
      "text": "class Point3d {\npublic:\nvirtual ~Point3d();\n// ...\nprotected:\nstatic Point3d origin;\nfloat x, y, z;\n};\n\n// float Point3d::*x\n&Point3d::z;\n// float *\n&origin.z; \n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Point3d {\npublic:\nvirtual ~Point3d();\n// ...\nprotected:\nstatic Point3d origin;\nfloat x, y, z;\n};\n\n// float Point3d::*x\n&Point3d::z;\n// float *\n&origin.z; \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e3qfbOlRViYOcWYl63Bqx",
      "type": "text",
      "x": 813.3332875569665,
      "y": 5147.261958167665,
      "width": 1001.8677368164062,
      "height": 140,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FOAM7-xkIu1exxseVZPs7",
      "index": "b98l",
      "roundness": null,
      "seed": 841842871,
      "version": 124,
      "versionNonce": 84970073,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777425494371,
      "link": null,
      "locked": false,
      "text": "The Standard permits the vptr to be placed anywhere within the object: \nat the beginning, at the end, or in between either of the three members.\nIn practice, all implementations place it either at the beginning or\nat the end.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Standard permits the vptr to be placed anywhere within the object: \nat the beginning, at the end, or in between either of the three members.\nIn practice, all implementations place it either at the beginning or\nat the end.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FoS-clFgaQHodcV4F-6fX",
      "type": "text",
      "x": 1272.599990844727,
      "y": 5493.928624834333,
      "width": 261.7998962402344,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FOAM7-xkIu1exxseVZPs7",
      "index": "b98t",
      "roundness": null,
      "seed": 690842583,
      "version": 186,
      "versionNonce": 2044109751,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777425494371,
      "link": null,
      "locked": false,
      "text": "&Point3d::x; // 0\n&Point3d::y; // 4\n&Point3d::z; // 8",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "&Point3d::x; // 0\n&Point3d::y; // 4\n&Point3d::z; // 8",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JP-9oy5hLTWEFtBPVCNrK",
      "type": "text",
      "x": 1104.999954223633,
      "y": 5633.928624834333,
      "width": 1296.3994140625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FOAM7-xkIu1exxseVZPs7",
      "index": "b98x",
      "roundness": null,
      "seed": 1499001463,
      "version": 261,
      "versionNonce": 790615865,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777425494371,
      "link": null,
      "locked": false,
      "text": "The value returned from taking the member's address, however, is always bumped up by 1. \nThus the actual values are 1, 5, and 9, and so on. Do you see why Bjarne decided to do that?",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The value returned from taking the member's address, however, is always bumped up by 1. \nThus the actual values are 1, 5, and 9, and so on. Do you see why Bjarne decided to do that?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ecmA_I59nu4vZKsMNVobT",
      "type": "text",
      "x": 1113.333287556967,
      "y": 5698.928624834332,
      "width": 1150.7435302734375,
      "height": 70,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FOAM7-xkIu1exxseVZPs7",
      "index": "b98z",
      "roundness": null,
      "seed": 1909979063,
      "version": 179,
      "versionNonce": 886510807,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777425494371,
      "link": null,
      "locked": false,
      "text": "The problem is distinguishing between a pointer to no data member and a pointer to\nthe first data member.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The problem is distinguishing between a pointer to no data member and a pointer to\nthe first data member.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8u0bZivkMo0lOQ4QAADW5",
      "type": "text",
      "x": 1831.6666208902989,
      "y": 5143.928624834332,
      "width": 575.5855102539062,
      "height": 550.9956709956701,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FOAM7-xkIu1exxseVZPs7",
      "index": "b98zV",
      "roundness": null,
      "seed": 2027893879,
      "version": 449,
      "versionNonce": 2003994649,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777425494371,
      "link": null,
      "locked": false,
      "text": "// Vptr Placement at Front of Class\n// modern compiler(x64) output:\nprintf(\"offset::x %p\\n\", &Point3D::x);\nprintf(\"offset::y %p\\n\", &Point3D::y);\nprintf(\"offset::z %p\\n\", &Point3D::z);\noffset::x 0000000000000008\noffset::y 000000000000000C\noffset::z 0000000000000010\noffsetof(Point3d, x)\noffsetof(Point3d, y)\noffsetof(Point3d, z)\noffsetof(Point3D, x): 8\noffsetof(Point3D, y): 12\noffsetof(Point3D, z): 16\n\n",
      "fontSize": 27.549783549783506,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Vptr Placement at Front of Class\n// modern compiler(x64) output:\nprintf(\"offset::x %p\\n\", &Point3D::x);\nprintf(\"offset::y %p\\n\", &Point3D::y);\nprintf(\"offset::z %p\\n\", &Point3D::z);\noffset::x 0000000000000008\noffset::y 000000000000000C\noffset::z 0000000000000010\noffsetof(Point3d, x)\noffsetof(Point3d, y)\noffsetof(Point3d, z)\noffsetof(Point3D, x): 8\noffsetof(Point3D, y): 12\noffsetof(Point3D, z): 16\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VXYhNHW9P-BDAHDgQO7AM",
      "type": "text",
      "x": 1169.9999542236333,
      "y": 5778.095291501,
      "width": 831.5997314453125,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FOAM7-xkIu1exxseVZPs7",
      "index": "b98zl",
      "roundness": null,
      "seed": 746997239,
      "version": 179,
      "versionNonce": 1424777719,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777425494371,
      "link": null,
      "locked": false,
      "text": "float Point3d::*p1 = 0;\nfloat Point3d::*p2 = &Point3d::x;\n// oops: how to distinguish?\nif ( p1 == p2 ) {\ncout << \" p1 & p2 contain the same value — \";\ncout << \" they must address the same member!\" << endl;\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "float Point3d::*p1 = 0;\nfloat Point3d::*p2 = &Point3d::x;\n// oops: how to distinguish?\nif ( p1 == p2 ) {\ncout << \" p1 & p2 contain the same value — \";\ncout << \" they must address the same member!\" << endl;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QOrJMTr9_X5tgqNwKxRuH",
      "type": "text",
      "x": 453.33328755696675,
      "y": 5612.261958167666,
      "width": 692.9996948242188,
      "height": 735,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FOAM7-xkIu1exxseVZPs7",
      "index": "b98zt",
