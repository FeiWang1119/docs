    {
      "id": "dZ9zQnxZ4aSpPMNMluowd",
      "type": "text",
      "x": 2812.14281136649,
      "y": 537.3809676397414,
      "width": 57.43994140625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
