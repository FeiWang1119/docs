      "index": "Zzzzzzzzzz",
      "roundness": null,
      "seed": 1367130327,
      "version": 1686,
      "versionNonce": 249696313,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777356783922,
      "link": null,
      "locked": false,
      "text": "void\nPoint3d::\noperator+=( const Point3d &rhs )\n{\n_x += rhs._x;\n_y += rhs._y;\n_z += rhs._z;\n};\n\n// Pseudo C++ Code\n(this + __vptr__Point3d[-1])->_x +=\n(&rhs + rhs.__vptr__Point3d[-1])->_x;\n(this + __vptr__Point3d[-1])->_y +=\n(&rhs + rhs.__vptr__Point3d[-1])->_y;\n_z += rhs._z;\n\nPoint2d *p2d = pv3d;\n// Pseudo C++ code\nPoint2d *p2d = pv3d\n? pv3d + pv3d->__vptr__Point3d[-1]) : 0;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void\nPoint3d::\noperator+=( const Point3d &rhs )\n{\n_x += rhs._x;\n_y += rhs._y;\n_z += rhs._z;\n};\n\n// Pseudo C++ Code\n(this + __vptr__Point3d[-1])->_x +=\n(&rhs + rhs.__vptr__Point3d[-1])->_x;\n(this + __vptr__Point3d[-1])->_y +=\n(&rhs + rhs.__vptr__Point3d[-1])->_y;\n_z += rhs._z;\n\nPoint2d *p2d = pv3d;\n// Pseudo C++ code\nPoint2d *p2d = pv3d\n? pv3d + pv3d->__vptr__Point3d[-1]) : 0;",
      "autoResize": false,
      "lineHeight": 1.25
    },
