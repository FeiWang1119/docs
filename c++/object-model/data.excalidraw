      "link": null,
      "locked": false,
      "text": "void\nPoint3d::\noperator+=( const Point3d &rhs )\n{\n_x += rhs._x;\n_y += rhs._y;\n_z += rhs._z;\n};\n\n// Pseudo C++ Code\n__vbcPoint2d->_x += rhs.__vbcPoint2d->_x;\n__vbcPoint2d->_y += rhs.__vbcPoint2d->_y;\n_z += rhs._z;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void\nPoint3d::\noperator+=( const Point3d &rhs )\n{\n_x += rhs._x;\n_y += rhs._y;\n_z += rhs._z;\n};\n\n// Pseudo C++ Code\n__vbcPoint2d->_x += rhs.__vbcPoint2d->_x;\n__vbcPoint2d->_y += rhs.__vbcPoint2d->_y;\n_z += rhs._z;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fV92284qyEJ3dUQIi5k6A",
      "type": "text",
      "x": 1574.8174603174607,
      "y": 3703.400793650793,
      "width": 143,
