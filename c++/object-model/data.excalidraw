      "boundElements": null,
      "updated": 1777340107688,
      "link": null,
      "locked": false,
      "text": "In the layout of iostream, however, we need only a single ios subobject.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In the layout of iostream, however, we need only a single ios subobject.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x1p9oTceU1BR0iyP5aP_r",
      "type": "text",
      "x": 449.28571428571433,
      "y": 3010.9642857142853,
      "width": 432.2829895019531,
      "height": 671.0000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "z0RWULOWfdgoyUkoZAGuF",
      "index": "Zzzzz",
      "roundness": null,
      "seed": 1763201817,
      "version": 1218,
      "versionNonce": 22409079,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777340107688,
      "link": null,
      "locked": false,
      "text": "class Point2d {\npublic:\n...\nprotected:\nfloat _x, _y;\n};\n\nclass Point3d : public virtual Point2d {\npublic:\n...\nprotected:\nfloat _z;\n};\n\nclass Vertex2d : public virtual Point2d {\npublic:\n...\nprotected:\nVertex *next;\n};\n\nclass Vertex3d :\npublic Point3d, public Vertex2d {\npublic:\n...\nprotected:\nfloat mumble;\n};",
      "fontSize": 19.171428571428574,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Point2d {\npublic:\n...\nprotected:\nfloat _x, _y;\n};\n\nclass Point3d : public virtual Point2d {\npublic:\n...\nprotected:\nfloat _z;\n};\n\nclass Vertex2d : public virtual Point2d {\npublic:\n...\nprotected:\nVertex *next;\n};\n\nclass Vertex3d :\npublic Point3d, public Vertex2d {\npublic:\n...\nprotected:\nfloat mumble;\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
