      "endBinding": null,
      "startArrowhead": null,
      "endArrowhead": "arrow",
      "elbowed": false
    },
    {
      "id": "Ro7H_cXr5ByILPg5_8buX",
      "type": "text",
      "x": 1252.0832875569668,
      "y": 3910.6786248343324,
      "width": 861.125701904297,
      "height": 52.499999999999986,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "z0RWULOWfdgoyUkoZAGuF",
      "index": "Zzzzzzzzzzzzz",
      "roundness": null,
      "seed": 867488503,
      "version": 434,
      "versionNonce": 588034777,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777356556368,
      "link": null,
      "locked": false,
      "text": "The general layout strategy is to first lay down the invariant region of the derived\nclass and then build up the shared region.",
      "fontSize": 20.99999999999999,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The general layout strategy is to first lay down the invariant region of the derived\nclass and then build up the shared region.",
      "autoResize": true,
      "lineHeight": 1.25
    },
