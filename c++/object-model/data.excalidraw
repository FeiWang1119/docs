    {
      "id": "BR_VPzk59KKUU_JnJhsqg",
      "type": "text",
      "x": 446.78571428571433,
      "y": 3119.9642857142853,
      "width": 699.11962890625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "z0RWULOWfdgoyUkoZAGuF",
      "index": "Zzzz",
      "roundness": null,
      "seed": 1706841911,
      "version": 1226,
      "versionNonce": 1255412023,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777356556368,
      "link": null,
      "locked": false,
      "text": "In the layout of iostream, however, we need only a single ios subobject.\nThe language level solution is the introduction of virtual inheritance:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In the layout of iostream, however, we need only a single ios subobject.\nThe language level solution is the introduction of virtual inheritance:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x1p9oTceU1BR0iyP5aP_r",
      "type": "text",
      "x": 448.0357142857142,
      "y": 3278.4642857142853,
      "width": 421.739501953125,
      "height": 671.0000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "z0RWULOWfdgoyUkoZAGuF",
      "index": "Zzzzz",
      "roundness": null,
      "seed": 1763201817,
      "version": 1526,
      "versionNonce": 152699321,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777356556368,
      "link": null,
      "locked": false,
      "text": "class Point2d {\npublic:\n...\nprotected:\nfloat _x, _y;\n};\n\nclass Point3d : public virtual Point2d {\npublic:\n...\nprotected:\nfloat _z;\n};\n\nclass Vertex : public virtual Point2d {\npublic:\n...\nprotected:\nVertex *next;\n};\n\nclass Vertex3d :\npublic Vertex, public Point3d {\npublic:\n...\nprotected:\nfloat mumble;\n};",
      "fontSize": 19.171428571428574,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Point2d {\npublic:\n...\nprotected:\nfloat _x, _y;\n};\n\nclass Point3d : public virtual Point2d {\npublic:\n...\nprotected:\nfloat _z;\n};\n\nclass Vertex : public virtual Point2d {\npublic:\n...\nprotected:\nVertex *next;\n};\n\nclass Vertex3d :\npublic Vertex, public Point3d {\npublic:\n...\nprotected:\nfloat mumble;\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
