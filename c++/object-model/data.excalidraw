    {
      "id": "eFuwaMUqdmUw6AcjxQn3C",
      "type": "text",
      "x": 432.9730268205916,
      "y": -450.3690476190477,
      "width": 289.83966064453125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "EPvOzwiAxuTM0yHHErEJm",
      "index": "b3k",
      "roundness": null,
      "seed": 967974009,
      "version": 172,
      "versionNonce": 1397114169,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777290486033,
      "link": null,
      "locked": false,
      "text": "class Point3d {\npublic:\n// ...\nprivate:\nfloat x;\nstatic List<Point3d*> *freeList;\nfloat y;\nstatic const int chunkSize = 250;\nfloat z;\n};\n\nPoint3d origin, *pt = &origin;\norigin.x = 0.0;\npt->x = 0.0;",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Point3d {\npublic:\n// ...\nprivate:\nfloat x;\nstatic List<Point3d*> *freeList;\nfloat y;\nstatic const int chunkSize = 250;\nfloat z;\n};\n\nPoint3d origin, *pt = &origin;\norigin.x = 0.0;\npt->x = 0.0;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g_zmtyMubh9fAvbfRghx2",
      "type": "text",
      "x": 1659.3029676164902,
