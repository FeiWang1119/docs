      "isDeleted": false,
      "boundElements": null,
      "updated": 1777340107688,
      "link": null,
      "locked": false,
      "text": "void\nPoint3d::\noperator+=( const Point3d &rhs )\n{\n_x += rhs._x;\n_y += rhs._y;\n_z += rhs._z;\n};\n\n// Pseudo C++ Code\n(this + __vptr__Point3d[-1])->_x +=\n(&rhs + rhs.__vptr__Point3d[-1])->_x;\n(this + __vptr__Point3d[-1])->_y +=\n(&rhs + rhs.__vptr__Point3d[-1])->_y;\n_z += rhs._z;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void\nPoint3d::\noperator+=( const Point3d &rhs )\n{\n_x += rhs._x;\n_y += rhs._y;\n_z += rhs._z;\n};\n\n// Pseudo C++ Code\n(this + __vptr__Point3d[-1])->_x +=\n(&rhs + rhs.__vptr__Point3d[-1])->_x;\n(this + __vptr__Point3d[-1])->_y +=\n(&rhs + rhs.__vptr__Point3d[-1])->_y;\n_z += rhs._z;",
      "autoResize": false,
      "lineHeight": 1.25
    },
