    {
      "id": "APS6dJuZVXyrvN9FChDKx",
      "type": "text",
      "x": 439.64281136649004,
      "y": 168.63096763974136,
      "width": 363,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "pkDyDOfbi4IQsej1baoX3",
      "index": "b3lV",
      "roundness": null,
      "seed": 503910585,
      "version": 95,
      "versionNonce": 253562873,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777292378668,
      "link": null,
      "locked": false,
      "text": "// supporting abstract data types\nclass Point2d {\npublic:\n// constructor(s)\n// operations\n// access functions\nprivate:\nfloat x, y;\n};\n\nclass Point3d {\npublic:\n// constructor(s)\n// operations\n// access functions\nprivate:\nfloat x, y, z;\n};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// supporting abstract data types\nclass Point2d {\npublic:\n// constructor(s)\n// operations\n// access functions\nprivate:\nfloat x, y;\n};\n\nclass Point3d {\npublic:\n// constructor(s)\n// operations\n// access functions\nprivate:\nfloat x, y, z;\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yza3O2ijws8wPZ9ujAqjV",
      "type": "text",
      "x": 768.39281136649,
      "y": 227.38096763974136,
      "width": 303.2996520996094,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "pkDyDOfbi4IQsej1baoX3",
      "index": "b3ll",
      "roundness": null,
      "seed": 265323799,
      "version": 189,
      "versionNonce": 1224132631,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777292378668,
      "link": null,
      "locked": false,
      "text": "Data Layout: Independent Structs",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data Layout: Independent Structs",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YKpaJ_tXWHIGS61ZQEAW0",
      "type": "text",
      "x": 1652.1428113664902,
      "y": 164.88096763974136,
      "width": 594,
      "height": 800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "pkDyDOfbi4IQsej1baoX3",
      "index": "b3lx",
      "roundness": null,
      "seed": 201471065,
      "version": 411,
      "versionNonce": 2093656281,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777292378668,
      "link": null,
      "locked": false,
      "text": "class Point2d {\npublic:\nPoint2d( float x = 0.0, float y = 0.0 )\n: _x( x ), _y( y ) {};\nfloat x() { return _x; }\nfloat y() { return _y; }\nvoid x( float newX ) { _x = newX; }\nvoid y( float newY ) { _y = newY; }\nvoid operator+=( const Point2d& rhs ) {\n_x += rhs.x();\n_y += rhs.y();\n}\n// ... more members\nprotected:\nfloat _x, _y;\n};\n\n// inheritance from concrete class\nclass Point3d : public Point2d {\npublic:\nPoint3d( float x = 0.0, float y = 0.0, float z = 0.0 )\n: Point2d( x, y ), _z( z ) {};\nfloat z() { return _z; }\nvoid z( float newZ ) { _z = newZ; }\nvoid operator+=( const Point3d& rhs ) {\nPoint2d::operator+=( rhs );\n_z += rhs.z();\n}\n// ... more members\nprotected:\nfloat _z;\n};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Point2d {\npublic:\nPoint2d( float x = 0.0, float y = 0.0 )\n: _x( x ), _y( y ) {};\nfloat x() { return _x; }\nfloat y() { return _y; }\nvoid x( float newX ) { _x = newX; }\nvoid y( float newY ) { _y = newY; }\nvoid operator+=( const Point2d& rhs ) {\n_x += rhs.x();\n_y += rhs.y();\n}\n// ... more members\nprotected:\nfloat _x, _y;\n};\n\n// inheritance from concrete class\nclass Point3d : public Point2d {\npublic:\nPoint3d( float x = 0.0, float y = 0.0, float z = 0.0 )\n: Point2d( x, y ), _z( z ) {};\nfloat z() { return _z; }\nvoid z( float newZ ) { _z = newZ; }\nvoid operator+=( const Point3d& rhs ) {\nPoint2d::operator+=( rhs );\n_z += rhs.z();\n}\n// ... more members\nprotected:\nfloat _z;\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
