    {
      "id": "K2AaLC49SZuL24AuYmq-6",
      "type": "text",
      "x": 414.1428571428572,
      "y": -1538.1190476190477,
      "width": 583,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Z23yexhWsMba6t6AWkSub",
      "index": "b2OV",
      "roundness": null,
      "seed": 214200151,
      "version": 219,
      "versionNonce": 1795579417,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777269079470,
      "link": null,
      "locked": false,
      "text": "class X {};\nclass Y: public virtual X {};\nclass Z : public virtual X {};\nclass A : public Y, public Z {};\n\nstd::cout << \"sizeof(X): \" << sizeof(X) << std::endl;\nstd::cout << \"sizeof(Y): \" << sizeof(Y) << std::endl;\nstd::cout << \"sizeof(Z): \" << sizeof(Z) << std::endl;\nstd::cout << \"sizeof(A): \" << sizeof(A) << std::endl;\n\nsizeof(X): 1\nsizeof(Y): 8\nsizeof(Z): 8\nsizeof(A): 12\n\nmodern compiler:\nsizeof(X): 1\nsizeof(Y): 8\nsizeof(Z): 8\nsizeof(A): 16",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class X {};\nclass Y: public virtual X {};\nclass Z : public virtual X {};\nclass A : public Y, public Z {};\n\nstd::cout << \"sizeof(X): \" << sizeof(X) << std::endl;\nstd::cout << \"sizeof(Y): \" << sizeof(Y) << std::endl;\nstd::cout << \"sizeof(Z): \" << sizeof(Z) << std::endl;\nstd::cout << \"sizeof(A): \" << sizeof(A) << std::endl;\n\nsizeof(X): 1\nsizeof(Y): 8\nsizeof(Z): 8\nsizeof(A): 12\n\nmodern compiler:\nsizeof(X): 1\nsizeof(Y): 8\nsizeof(Z): 8\nsizeof(A): 16",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "L1FXXoiEdn-Ovp3SnMyaz",
      "type": "text",
      "x": 1010.3928571428573,
      "y": -1415.3690476190477,
      "width": 822.662841796875,
      "height": 124.10714285714272,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Z23yexhWsMba6t6AWkSub",
      "index": "b2Ol",
      "roundness": null,
      "seed": 260855641,
      "version": 568,
      "versionNonce": 1974004727,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777269079470,
      "link": null,
      "locked": false,
      "text": "Rather it has an associated size of 1 byte—a char member inserted by the compiler. \nThis allows two objects of the class, such as\nX a, b;\nif ( &a == &b ) cerr << \"yipes!\" << endl;\nto be allocated unique addresses in memory.",
      "fontSize": 19.857142857142836,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rather it has an associated size of 1 byte—a char member inserted by the compiler. \nThis allows two objects of the class, such as\nX a, b;\nif ( &a == &b ) cerr << \"yipes!\" << endl;\nto be allocated unique addresses in memory.",
      "autoResize": true,
      "lineHeight": 1.25
    },
