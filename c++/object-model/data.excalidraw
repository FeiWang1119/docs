    {
      "id": "ovFEm6q2mZCL9CiWLW3_e",
      "type": "text",
      "x": 688.9642857142859,
      "y": 4158.142857142856,
      "width": 443.74603174603186,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
