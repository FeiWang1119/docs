    {
      "id": "YTu0UD2Van9CzeyNgRzjP",
      "type": "text",
      "x": 447.28571428571433,
      "y": 3697.9642857142853,
      "width": 797.5994262695312,
      "height": 200,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "z0RWULOWfdgoyUkoZAGuF",
      "index": "Zzzzzx",
      "roundness": null,
      "seed": 257212695,
      "version": 1323,
      "versionNonce": 1181940727,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777340107688,
      "link": null,
      "locked": false,
      "text": "two primary weaknesses with this implementation model\n1. An object of the class carries an additional pointer for each virtual base class.\nIdeally, we want a constant overhead for the class object that is independent\nof the number of virtual base classes within its inheritance hierarchy.\n2. As the virtual inheritance chain lengthens, the level of indirection increases to\nthat depth. This means that three levels of virtual derivation requires\nindirection through three virtual base class pointers. Ideally, we want a\nconstant access time regardless of the depth of the virtual derivation.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "two primary weaknesses with this implementation model\n1. An object of the class carries an additional pointer for each virtual base class.\nIdeally, we want a constant overhead for the class object that is independent\nof the number of virtual base classes within its inheritance hierarchy.\n2. As the virtual inheritance chain lengthens, the level of indirection increases to\nthat depth. This means that three levels of virtual derivation requires\nindirection through three virtual base class pointers. Ideally, we want a\nconstant access time regardless of the depth of the virtual derivation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
